{
  "name": "gpsart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:factory": "node --test tests/factory.test.mjs",
    "factory:status": "node scripts/factory.mjs status",
    "factory:next": "node scripts/factory.mjs next",
    "factory:verify": "node scripts/factory.mjs verify"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@vitejs/plugin-react": "5.0.4",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
