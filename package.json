{
  "name": "gpsart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:visual-shell": "node --test tests/visual-shell-regression.test.mjs",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "rust:build": "node scripts/cargo.mjs build --workspace",
    "rust:test": "node scripts/cargo.mjs test --workspace -- --test-threads=1",
    "rust:fmt": "node scripts/cargo.mjs fmt --all -- --check",
    "rust:clippy": "node scripts/cargo.mjs clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test:factory": "node --test tests/factory.test.mjs tests/persistence-contract.test.mjs tests/rust-workspace.test.mjs",
    "test:persistence": "node --test tests/persistence-contract.test.mjs && node scripts/cargo.mjs test -p gpsart-persistence --test migrations -- --test-threads=1",
    "factory:status": "node scripts/factory.mjs status",
    "factory:next": "node scripts/factory.mjs next",
    "factory:verify": "node scripts/factory.mjs verify"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "leaflet": "^1.9.4",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
