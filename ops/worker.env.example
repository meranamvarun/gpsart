# Non-secret worker settings. Supply GPSART_DATABASE_URL through the deployment secret store.
GPSART_COVERAGE_VERSION=bengaluru-central-pilot-v1
GPSART_ROUTING_GRAPH_PATH=/srv/gpsart/data/bengaluru-central-osm-v3.json
GPSART_ROUTING_GRAPH_SHA256_PATH=/srv/gpsart/data/bengaluru-central-osm-v3.sha256
GPSART_MAX_PROVIDER_REQUESTS=50
GPSART_MAX_RUNTIME_SECONDS=60
