apiVersion: v1
kind: ConfigMap
metadata:
  name: gpsart-grafana-dashboard
  namespace: __NAMESPACE__
  labels:
    gpsart.dev/release-phase: monitoring
    grafana_dashboard: "1"
data:
  gpsart-production-operations.json: |-
__DASHBOARD_JSON__
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: gpsart-collector-contract
  namespace: __NAMESPACE__
  labels:
    gpsart.dev/release-phase: monitoring
    gpsart.dev/collector-contract: "1"
data:
  collector-contract.json: |-
__COLLECTOR_JSON__
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: gpsart-production-alerts
  namespace: __NAMESPACE__
  labels:
    gpsart.dev/release-phase: monitoring
spec:
  groups:
    - name: gpsart.production
      rules:
__PROMETHEUS_RULES__
---
apiVersion: monitoring.coreos.com/v1alpha1
kind: AlertmanagerConfig
metadata:
  name: gpsart-alert-routing
  namespace: __NAMESPACE__
  labels:
    gpsart.dev/release-phase: monitoring
spec:
  route:
    receiver: gpsart-primary
    groupBy: [alertname, severity]
    groupWait: 30s
    groupInterval: 5m
    repeatInterval: 4h
    routes:
      - receiver: gpsart-deadman
        matchers:
          - { name: route, value: gpsart-deadman }
  receivers:
    - name: gpsart-primary
      webhookConfigs:
        - urlSecret: { name: __ALERT_RECEIVER_SECRET__, key: url }
          sendResolved: true
    - name: gpsart-deadman
      webhookConfigs:
        - urlSecret: { name: __DEADMAN_RECEIVER_SECRET__, key: url }
          sendResolved: true
