apiVersion: v1
kind: Namespace
metadata:
  name: __NAMESPACE__
  annotations:
    gpsart.dev/teardown-protected: "true"
  labels:
    app.kubernetes.io/part-of: gpsart
    gpsart.dev/environment: __ENVIRONMENT__
    gpsart.dev/release-phase: foundation
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: gpsart-runtime
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: __SECRET_STORE__
  target:
    name: gpsart-runtime
    creationPolicy: Owner
  data:
    - secretKey: GPSART_DATABASE_URL
      remoteRef:
        key: __RUNTIME_DATABASE_SECRET_REF__
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: gpsart-migration
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: __SECRET_STORE__
  target:
    name: gpsart-migration
    creationPolicy: Owner
  data:
    - secretKey: DATABASE_URL
      remoteRef:
        key: __MIGRATION_DATABASE_SECRET_REF__
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: gpsart-postgres-bootstrap
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: __SECRET_STORE__
  target:
    name: gpsart-postgres-bootstrap
    creationPolicy: Owner
  dataFrom:
    - extract:
        key: __POSTGRES_BOOTSTRAP_SECRET_REF__
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: gpsart-runtime
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
data:
  GPSART_API_BIND: "0.0.0.0:8080"
  GPSART_PUBLIC_ORIGIN: "__PUBLIC_ORIGIN__"
  GPSART_ROUTING_MANIFEST: "/app/ops/routing/production-pilot-v1.json"
  GPSART_COVERAGE_VERSION: "bengaluru-central-pilot-coverage-v1"
  GPSART_ROUTING_GRAPH_PATH: "/app/data/bengaluru-central-osm-v3.json"
  GPSART_ROUTING_GRAPH_SHA256_PATH: "/app/data/bengaluru-central-osm-v3.sha256"
  GPSART_MAX_PROVIDER_REQUESTS: "50"
  GPSART_MAX_RUNTIME_SECONDS: "60"
  RUST_LOG: "info"
---
apiVersion: v1
kind: Service
metadata:
  name: gpsart-postgres
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
spec:
  selector: { app.kubernetes.io/name: gpsart-postgres }
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: gpsart-postgres
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
  annotations:
    gpsart.dev/source-revision: "__SOURCE_REVISION__"
spec:
  serviceName: gpsart-postgres
  replicas: 1
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Retain
  selector:
    matchLabels: { app.kubernetes.io/name: gpsart-postgres }
  template:
    metadata:
      labels: { app.kubernetes.io/name: gpsart-postgres }
    spec:
      securityContext:
        fsGroup: 999
      terminationGracePeriodSeconds: 60
      containers:
        - name: postgres
          image: postgis/postgis:16-3.4@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef: { name: gpsart-postgres-bootstrap }
          ports: [{ name: postgres, containerPort: 5432 }]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            runAsNonRoot: true
            runAsUser: 999
            runAsGroup: 999
          livenessProbe:
            exec: { command: ["pg_isready", "-U", "gpsart", "-d", "gpsart"] }
            periodSeconds: 15
          readinessProbe:
            exec: { command: ["pg_isready", "-U", "gpsart", "-d", "gpsart"] }
            periodSeconds: 5
          volumeMounts:
            - { name: data, mountPath: /var/lib/postgresql/data }
  volumeClaimTemplates:
    - metadata:
        name: data
        annotations:
          gpsart.dev/encryption-required: "true"
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: __STORAGE_CLASS__
        resources: { requests: { storage: 20Gi } }
---
apiVersion: batch/v1
kind: Job
metadata:
  name: gpsart-migrate-__REVISION_SHORT__
  namespace: __NAMESPACE__
  labels: { app.kubernetes.io/name: gpsart-migrate, gpsart.dev/release-phase: migration }
  annotations:
    gpsart.dev/source-revision: "__SOURCE_REVISION__"
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels: { app.kubernetes.io/name: gpsart-migrate }
    spec:
      restartPolicy: Never
      serviceAccountName: gpsart-migrator
      securityContext: { runAsNonRoot: true, seccompProfile: { type: RuntimeDefault } }
      initContainers:
        - name: wait-for-postgres
          image: postgis/postgis:16-3.4@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
          command: ["sh", "-c", "until pg_isready -h gpsart-postgres -p 5432; do sleep 2; done"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 999
      containers:
        - name: gpsart-migrate
          image: __MIGRATE_IMAGE__
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef: { name: gpsart-migration }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gpsart-migrator
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
automountServiceAccountToken: false
---
apiVersion: v1
kind: Service
metadata:
  name: gpsart-api
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
spec:
  selector: { app.kubernetes.io/name: gpsart-api }
  ports: [{ name: http, port: 8080, targetPort: http }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gpsart-api
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
  annotations: { gpsart.dev/source-revision: "__SOURCE_REVISION__" }
spec:
  replicas: __API_REPLICAS__
  revisionHistoryLimit: 5
  selector:
    matchLabels: { app.kubernetes.io/name: gpsart-api }
  template:
    metadata:
      labels: { app.kubernetes.io/name: gpsart-api }
      annotations: { gpsart.dev/source-revision: "__SOURCE_REVISION__" }
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext: { runAsNonRoot: true, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: api
          image: __API_IMAGE__
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef: { name: gpsart-runtime }
            - secretRef: { name: gpsart-runtime }
          ports: [{ name: http, containerPort: 8080 }]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
          livenessProbe:
            httpGet: { path: /health/live, port: http }
            periodSeconds: 15
          readinessProbe:
            httpGet: { path: /health/ready, port: http }
            periodSeconds: 5
          resources:
            requests: { cpu: 100m, memory: 128Mi }
            limits: { cpu: "1", memory: 512Mi }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gpsart-worker
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
  annotations: { gpsart.dev/source-revision: "__SOURCE_REVISION__" }
spec:
  replicas: __WORKER_REPLICAS__
  revisionHistoryLimit: 5
  selector:
    matchLabels: { app.kubernetes.io/name: gpsart-worker }
  template:
    metadata:
      labels: { app.kubernetes.io/name: gpsart-worker }
      annotations: { gpsart.dev/source-revision: "__SOURCE_REVISION__" }
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 75
      securityContext: { runAsNonRoot: true, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: worker
          image: __WORKER_IMAGE__
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef: { name: gpsart-runtime }
            - secretRef: { name: gpsart-runtime }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
          readinessProbe:
            exec: { command: ["/app/gpsart-worker", "--check"] }
            periodSeconds: 30
            timeoutSeconds: 5
          resources:
            requests: { cpu: 250m, memory: 256Mi }
            limits: { cpu: "2", memory: 1Gi }
---
apiVersion: v1
kind: Service
metadata:
  name: gpsart-client-edge
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
spec:
  selector: { app.kubernetes.io/name: gpsart-client-edge }
  ports: [{ name: http, port: 8080, targetPort: http }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gpsart-client-edge
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
  annotations: { gpsart.dev/source-revision: "__SOURCE_REVISION__" }
spec:
  replicas: __EDGE_REPLICAS__
  revisionHistoryLimit: 5
  selector:
    matchLabels: { app.kubernetes.io/name: gpsart-client-edge }
  template:
    metadata:
      labels: { app.kubernetes.io/name: gpsart-client-edge }
      annotations: { gpsart.dev/source-revision: "__SOURCE_REVISION__" }
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext: { runAsNonRoot: true, seccompProfile: { type: RuntimeDefault } } 
      containers:
        - name: client-edge
          image: __CLIENT_EDGE_IMAGE__
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 8080 }]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 101
          volumeMounts:
            - { name: cache, mountPath: /var/cache/nginx }
            - { name: run, mountPath: /var/run }
            - { name: tmp, mountPath: /tmp }
          livenessProbe:
            httpGet: { path: /edge-health, port: http }
            periodSeconds: 15
          readinessProbe:
            httpGet: { path: /edge-health, port: http }
            periodSeconds: 5
          resources:
            requests: { cpu: 25m, memory: 32Mi }
            limits: { cpu: 250m, memory: 128Mi }
      volumes:
        - { name: cache, emptyDir: {} }
        - { name: run, emptyDir: {} }
        - { name: tmp, emptyDir: {} }
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gpsart
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
  annotations:
    cert-manager.io/cluster-issuer: __CERTIFICATE_ISSUER__
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "64k"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "2"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "70"
    nginx.ingress.kubernetes.io/enable-access-log: "false"
spec:
  ingressClassName: nginx
  tls:
    - hosts: [__HOSTNAME__]
      secretName: gpsart-edge-tls
  rules:
    - host: __HOSTNAME__
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: { name: gpsart-client-edge, port: { number: 8080 } }
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: gpsart-api
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: runtime }
spec:
  maxUnavailable: 1
  selector:
    matchLabels: { app.kubernetes.io/name: gpsart-api }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
spec:
  podSelector: {}
  policyTypes: ["Ingress", "Egress"]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: gpsart-allowed-flows
  namespace: __NAMESPACE__
  labels: { gpsart.dev/release-phase: foundation }
spec:
  podSelector:
    matchExpressions:
      - { key: app.kubernetes.io/name, operator: In, values: [gpsart-client-edge, gpsart-api, gpsart-worker, gpsart-migrate, gpsart-postgres] }
  policyTypes: ["Ingress", "Egress"]
  ingress:
    - from:
        - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: ingress-nginx } }
        - podSelector: {}
  egress:
    - to:
        - podSelector: {}
    - to:
        - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: kube-system } }
      ports:
        - { protocol: UDP, port: 53 }
        - { protocol: TCP, port: 53 }
