apiVersion: v1
kind: Namespace
metadata:
  name: __RECOVERY_NAMESPACE__
  labels: { gpsart.dev/purpose: isolated-recovery }
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata: { name: recovery-postgres, namespace: __RECOVERY_NAMESPACE__ }
spec:
  refreshInterval: 1h
  secretStoreRef: { kind: ClusterSecretStore, name: __SECRET_STORE__ }
  target: { name: recovery-postgres, creationPolicy: Owner }
  dataFrom: [{ extract: { key: __POSTGRES_BOOTSTRAP_SECRET_REF__ } }]
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: recovery-repository
  namespace: __RECOVERY_NAMESPACE__
  annotations: { gpsart.dev/access-audit-required: "true" }
spec:
  refreshInterval: 1h
  secretStoreRef: { kind: ClusterSecretStore, name: __SECRET_STORE__ }
  target: { name: recovery-repository, creationPolicy: Owner }
  dataFrom: [{ extract: { key: __BACKUP_REPOSITORY_SECRET_REF__ } }]
---
apiVersion: v1
kind: Service
metadata: { name: recovery-postgres, namespace: __RECOVERY_NAMESPACE__ }
spec:
  selector: { app.kubernetes.io/name: recovery-postgres }
  ports: [{ port: 5432, targetPort: 5432 }]
---
apiVersion: apps/v1
kind: StatefulSet
metadata: { name: recovery-postgres, namespace: __RECOVERY_NAMESPACE__ }
spec:
  serviceName: recovery-postgres
  replicas: 1
  selector: { matchLabels: { app.kubernetes.io/name: recovery-postgres } }
  template:
    metadata: { labels: { app.kubernetes.io/name: recovery-postgres } }
    spec:
      automountServiceAccountToken: false
      securityContext: { runAsNonRoot: true, fsGroup: 999, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: postgres
          image: postgis/postgis:16-3.4@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
          envFrom: [{ secretRef: { name: recovery-postgres } }]
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: ["ALL"] }, runAsUser: 999 }
          volumeMounts: [{ name: data, mountPath: /var/lib/postgresql/data }]
      volumes: [{ name: data, emptyDir: {} }]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: { name: recovery-default-deny, namespace: __RECOVERY_NAMESPACE__ }
spec: { podSelector: {}, policyTypes: ["Ingress", "Egress"] }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: { name: recovery-required-egress, namespace: __RECOVERY_NAMESPACE__ }
spec:
  podSelector: {}
  policyTypes: ["Ingress", "Egress"]
  ingress:
    - from: [{ podSelector: {} }]
  egress:
    - to: [{ podSelector: {} }]
    - to: [{ namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: kube-system } } }]
      ports: [{ protocol: UDP, port: 53 }, { protocol: TCP, port: 53 }]
    - ports: [{ protocol: TCP, port: 443 }]
---
apiVersion: batch/v1
kind: Job
metadata: { name: recovery-audit, namespace: __RECOVERY_NAMESPACE__ }
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 3600
  template:
    metadata: { labels: { app.kubernetes.io/name: recovery-audit } }
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      securityContext: { runAsNonRoot: true, seccompProfile: { type: RuntimeDefault } }
      initContainers:
        - name: wait-for-postgres
          image: postgis/postgis:16-3.4@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
          command: ["sh", "-c", "until pg_isready -h recovery-postgres -p 5432; do sleep 2; done"]
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: ["ALL"] }, runAsUser: 999 }
      containers:
        - name: recovery-audit
          image: __RECOVERY_IMAGE__
          command: ["/usr/local/bin/gpsart-rehearse"]
          envFrom:
            - secretRef: { name: recovery-postgres }
            - secretRef: { name: recovery-repository }
          env:
            - { name: PGHOST, value: recovery-postgres }
            - { name: RESTIC_CACHE_DIR, value: /tmp/restic-cache }
            - name: PGUSER
              valueFrom: { secretKeyRef: { name: recovery-postgres, key: POSTGRES_USER } }
            - name: PGPASSWORD
              valueFrom: { secretKeyRef: { name: recovery-postgres, key: POSTGRES_PASSWORD } }
            - name: PGDATABASE
              valueFrom: { secretKeyRef: { name: recovery-postgres, key: POSTGRES_DB } }
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: ["ALL"] }, runAsUser: 999 }
          volumeMounts: [{ name: tmp, mountPath: /tmp }]
      volumes: [{ name: tmp, emptyDir: {} }]
